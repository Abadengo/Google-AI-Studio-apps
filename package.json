{
  "name": "midas-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "npm run test:rules",
    "test:rules": "node scripts/build-firestore-rules.mjs && npx -y firebase-tools@15 emulators:exec --only auth,firestore --project demo-midas \"node tests/firestore-rules.test.mjs\"",
    "firebase:rules": "node scripts/build-firestore-rules.mjs",
    "deploy:rules": "node scripts/build-firestore-rules.mjs --deploy"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
