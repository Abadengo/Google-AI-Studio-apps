# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Nube compartida (Firebase) ────────────────────────────────────────────────────────────
# Configuración web de tu proyecto Firebase (Consola Firebase → Configuración del proyecto →
# Tus apps → App web). Estos valores son públicos (van en el navegador); la seguridad la dan
# las reglas de Firestore. Sin ellos, la app funciona como antes: datos solo en este navegador.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu-proyecto"
VITE_FIREBASE_APP_ID=""
# Opcionales:
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_HOUSEHOLD_ID="hogar"

# ALLOWED_EMAILS: las DOS cuentas de Google que pueden entrar (separadas por coma).
# Se usan para generar firestore.rules (npm run firebase:rules / npm run deploy:rules)
# y para que el servidor autorice las funciones de IA.
ALLOWED_EMAILS="persona1@gmail.com,persona2@gmail.com"

# AI_RATE_LIMIT_PER_MINUTE (opcional): máximo de llamadas de IA por minuto y por IP. Por defecto 20.
# AI_RATE_LIMIT_PER_MINUTE=20

# GEMINI_MODEL (opcional): modelo de Gemini a usar. Por defecto "gemini-flash-latest".
# GEMINI_MODEL="gemini-2.5-flash"

# PORT / HOST (opcionales): por defecto la app escucha solo en este equipo (127.0.0.1:3000).
# PORT=3000
# HOST=127.0.0.1
