# Copia este archivo como .env (local) o define estas variables en el hosting
# (AI Studio → Secrets / Cloud Run → Variables). Todas se leen al EJECUTAR la app.

# ── IA (Gemini) ─────────────────────────────────────────────────────────────────────────
# Necesaria para leer PDF escaneados/fotos, clasificar movimientos y el agente.
# AI Studio la inyecta automáticamente desde tus Secrets.
GEMINI_API_KEY=""

# ── Nube compartida (Firebase) ──────────────────────────────────────────────────────────
# Consola Firebase → Configuración del proyecto → Tus apps → App web.
# Son valores públicos (llegan al navegador); la seguridad la dan las reglas de Firestore.
# Sin ellos, la app funciona en modo local (datos solo en el navegador).
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
FIREBASE_PROJECT_ID="tu-proyecto"
FIREBASE_APP_ID=""

# Las DOS cuentas de Google que pueden entrar (separadas por coma). Se usan para generar las
# reglas de Firestore (npm run deploy:rules) y para autorizar las funciones de IA en el servidor.
ALLOWED_EMAILS="persona1@example.com,persona2@example.com"

# ── Opcionales ──────────────────────────────────────────────────────────────────────────
# FIREBASE_STORAGE_BUCKET=""
# FIREBASE_MESSAGING_SENDER_ID=""
# FIREBASE_HOUSEHOLD_ID="hogar"        # documento compartido en Firestore
# GEMINI_MODEL="gemini-flash-latest"   # modelo de Gemini
# AI_RATE_LIMIT_PER_MINUTE=20          # llamadas de IA por minuto e IP
# PORT=3000                            # Cloud Run lo define automáticamente
# HOST=0.0.0.0
